# ==============================================================================
# FedHeal Git Ignore Configuration
# ==============================================================================

# Environment files & Secrets (NEVER commit credentials)
.env
**/.env
.env.*.local
*.env.local
firebase_pk.json

# Local development document stores & locks
*_store.json
*_store.json.lock
.store-*.tmp
backend/*_store.json*
*.db
*.sqlite
*.sqlite3

# Python build, cache & bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend (React / Vite)
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test-results/
playwright-report/

# Machine Learning artifacts & checkpoints
model_artifacts/
checkpoints/

# Logs
*.log
firebase-debug.log*

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
